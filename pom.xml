<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.studyowl</groupId>
  <artifactId>auth-service</artifactId>
  <version>0.1.0</version>
  <name>auth-service</name>
  <description>StudyOwl phone-number/OTP auth backend, backed by AWS Cognito</description>

  <properties>
    <java.version>17</java.version>
    <!-- 2.29.11 predates Cognito's USER_AUTH/SMS_OTP model classes (verified by
         inspecting the jar directly) — needs >= the version that added them. -->
    <awssdk.version>2.49.3</awssdk.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${awssdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- awssdk:apache5-client:2.49.3 ships code compiled against
           org.apache.hc.client5.http.ssl.TlsSocketStrategy, added in httpclient5 5.4.
           Its own inherited parent POM pins an older 5.3.1 that lacks that class
           (NoClassDefFoundError at runtime) — override to a version that has it. -->
      <dependency>
        <groupId>org.apache.httpcomponents.client5</groupId>
        <artifactId>httpclient5</artifactId>
        <version>5.4.1</version>
      </dependency>
      <!-- httpclient5:5.4.1 itself requires httpcore5 5.3.1 (per its parent POM's
           httpcore.version property) but something upstream pins 5.2.5, which is
           missing constructors httpclient5 5.4.1 calls at runtime. Same class of
           issue as the httpclient5 override above. -->
      <dependency>
        <groupId>org.apache.httpcomponents.core5</groupId>
        <artifactId>httpcore5</artifactId>
        <version>5.3.1</version>
      </dependency>
      <dependency>
        <groupId>org.apache.httpcomponents.core5</groupId>
        <artifactId>httpcore5-h2</artifactId>
        <version>5.3.1</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Reactor types (Mono) for UserProfileClient's reactive interface, and WebClient
         for the real HTTP implementation once the User Profile service exists (TODO.md #3).
         Spring MVC (spring-boot-starter-web) remains the active server stack — having both
         starters on the classpath doesn't switch that; Spring Boot only auto-configures the
         WebFlux server when spring-webmvc is absent. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>

    <!-- Cognito: user lookup, USER_AUTH/SMS_OTP passwordless sign-in, token issuance -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>cognitoidentityprovider</artifactId>
    </dependency>
    <!-- S3: presigned upload URL for the optional profile photo -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
    </dependency>
    <!-- DynamoDB: ProfileSession store + RateLimiter counters (replaces in-memory maps) -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>dynamodb</artifactId>
    </dependency>
    <!-- Not called directly — required on the classpath for ProfileCredentialsProvider
         to assume a role for profiles like studyowl-dev (source_profile + role_arn).
         Without it: SdkClientException "the 'sts' service module must be on the class path". -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sts</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
